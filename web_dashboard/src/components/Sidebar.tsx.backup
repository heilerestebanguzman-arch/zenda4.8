import React, { useState, useEffect } from 'react';
import { NavLink } from 'react-router-dom';
import { useTheme } from '../context/ThemeContext';

interface SidebarProps {
  onCollapse?: (collapsed: boolean) => void;
}

const Sidebar: React.FC<SidebarProps> = ({ onCollapse }) => {
  const { theme } = useTheme();
  const [collapsed, setCollapsed] = useState(false);

  useEffect(() => {
    if (onCollapse) {
      onCollapse(collapsed);
    }
  }, [collapsed, onCollapse]);

  const menuItems = [
    { path: '/dashboard', icon: '🏠', label: 'Inicio' },
    { path: '/routes', icon: '🗺️', label: 'Rutas' },
    { path: '/routes-map', icon: '📍', label: 'Mapa' },
    { path: '/reports', icon: '📊', label: 'Reportes' },
    { path: '/drivers', icon: '👥', label: 'Conductores' },
  ];

  return (
    <aside className={`
      fixed left-0 top-0 h-full bg-white dark:bg-dark-surface shadow-lg transition-all duration-300 z-50
      ${collapsed ? 'w-16' : 'w-64'}
    `}>
      {/* Logo */}
      <div className="flex items-center justify-center h-16 border-b border-gray-200 dark:border-dark-border">
        <div className="flex items-center gap-2">
          <span className="text-2xl">🚀</span>
          {!collapsed && (
            <span className="text-xl font-bold text-gray-800 dark:text-white">
              ZENDA 4.8
            </span>
          )}
        </div>
      </div>

      {/* Botón colapsar */}
      <button
        onClick={() => setCollapsed(!collapsed)}
        className="absolute -right-3 top-4 bg-white dark:bg-dark-surface border border-gray-200 dark:border-dark-border rounded-full w-6 h-6 flex items-center justify-center hover:bg-gray-100 dark:hover:bg-dark-card shadow-md"
      >
        <span className="text-xs">{collapsed ? '▶' : '◀'}</span>
      </button>

      {/* Menú */}
      <nav className="mt-6">
        {menuItems.map((item) => (
          <NavLink
            key={item.path}
            to={item.path}
            className={({ isActive }) => `
              flex items-center gap-3 px-4 py-3 mx-2 rounded-lg transition-colors
              ${isActive 
                ? 'bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400' 
                : 'text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-dark-card'
              }
              ${collapsed ? 'justify-center' : ''}
            `}
          >
            <span className="text-xl">{item.icon}</span>
            {!collapsed && <span className="text-sm">{item.label}</span>}
          </NavLink>
        ))}
      </nav>

      {/* Footer del Sidebar */}
      <div className={`
        absolute bottom-0 left-0 right-0 p-4 border-t border-gray-200 dark:border-dark-border
        ${collapsed ? 'text-center' : ''}
      `}>
        {!collapsed ? (
          <div className="text-xs text-gray-500 dark:text-gray-400">
            <p>© 2026 ZENDA</p>
            <p className="text-gray-400 dark:text-gray-500">by TupayDux 🛡️</p>
          </div>
        ) : (
          <div className="text-xs text-gray-400 dark:text-gray-500">
            <p>©</p>
            <p>🛡️</p>
          </div>
        )}
      </div>
    </aside>
  );
};

export default Sidebar;
