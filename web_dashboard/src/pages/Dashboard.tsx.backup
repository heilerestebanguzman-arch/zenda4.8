import React, { useEffect, useState } from 'react';
import { useTranslation } from 'react-i18next';
import { orderService } from '../services/orderService';
import { reportService } from '../services/reportService';
import { DriversList } from '../components/DriversList';
import LanguageSelector from '../components/ui/LanguageSelector';
import {
  LineChart, Line, XAxis, YAxis, CartesianGrid, Tooltip, Legend, ResponsiveContainer,
  BarChart, Bar, Cell
} from 'recharts';

const DashboardPage: React.FC = () => {
  const { t } = useTranslation();
  const [summary, setSummary] = useState<any>(null);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    loadData();
  }, []);

  const loadData = async () => {
    try {
      const [, summaryData] = await Promise.all([
        orderService.getOrders(),
        reportService.getSummary()
      ]);
      setSummary(summaryData);
    } catch (error) {
      console.error('❌ Error cargando datos:', error);
    } finally {
      setLoading(false);
    }
  };

  if (loading) {
    return (
      <div className="flex items-center justify-center h-64">
        <div className="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-500"></div>
      </div>
    );
  }

  const revenueData = [
    { month: 'Ene', amount: 0 },
    { month: 'Feb', amount: 0 },
    { month: 'Mar', amount: 0 },
    { month: 'Abr', amount: 0 },
    { month: 'May', amount: 0 },
    { month: 'Jun', amount: 545.5 }
  ];

  const orderStatusData = [
    { name: 'Pendientes',   value: summary?.data?.pending_orders    || 0 },
    { name: 'Completadas',  value: summary?.data?.completed_orders   || 0 },
    { name: 'En Progreso',  value: summary?.data?.in_progress_orders || 0 }
  ];

  const colors = ['#f59e0b', '#10b981', '#3b82f6'];

  return (
    <div className="w-full">

      {/* Título + selector de idioma */}
      <div className="flex justify-between items-center mb-6">
        <h1 className="text-2xl font-bold text-gray-800 dark:text-white">
          📊 {t('dashboard.title', 'Dashboard')}
        </h1>
        <LanguageSelector />
      </div>

      {/* KPI Cards */}
      <div className="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4 mb-6">
        <div className="bg-white dark:bg-dark-card rounded-xl shadow-sm p-5 border-l-4 border-blue-500">
          <p className="text-sm text-gray-500 dark:text-gray-400">📋 {t('dashboard.total_orders', 'Total Órdenes')}</p>
          <p className="text-2xl font-bold text-gray-800 dark:text-white mt-1">
            {summary?.data?.total_orders || 0}
          </p>
        </div>
        <div className="bg-white dark:bg-dark-card rounded-xl shadow-sm p-5 border-l-4 border-yellow-500">
          <p className="text-sm text-gray-500 dark:text-gray-400">⏳ {t('dashboard.pending_orders', 'Pendientes')}</p>
          <p className="text-2xl font-bold text-yellow-600 mt-1">
            {summary?.data?.pending_orders || 0}
          </p>
        </div>
        <div className="bg-white dark:bg-dark-card rounded-xl shadow-sm p-5 border-l-4 border-green-500">
          <p className="text-sm text-gray-500 dark:text-gray-400">✅ {t('dashboard.completed_orders', 'Completadas')}</p>
          <p className="text-2xl font-bold text-green-600 mt-1">
            {summary?.data?.completed_orders || 0}
          </p>
        </div>
        <div className="bg-white dark:bg-dark-card rounded-xl shadow-sm p-5 border-l-4 border-purple-500">
          <p className="text-sm text-gray-500 dark:text-gray-400">💰 {t('dashboard.total_revenue', 'Ingresos')}</p>
          <p className="text-2xl font-bold text-purple-600 mt-1">
            ${summary?.data?.total_revenue || 0}
          </p>
        </div>
      </div>

      {/* Gráficos */}
      <div className="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
        <div className="bg-white dark:bg-dark-card rounded-xl shadow-sm p-5">
          <h3 className="text-lg font-semibold text-gray-700 dark:text-white mb-4">
            📈 Ingresos Mensuales
          </h3>
          <div style={{ width: '100%', height: 250 }}>
            <ResponsiveContainer width="100%" height="100%">
              <LineChart data={revenueData} margin={{ top: 5, right: 20, left: 0, bottom: 5 }}>
                <CartesianGrid strokeDasharray="3 3" />
                <XAxis dataKey="month" tick={{ fontSize: 12 }} />
                <YAxis tick={{ fontSize: 12 }} />
                <Tooltip />
                <Legend />
                <Line type="monotone" dataKey="amount" stroke="#3b82f6" strokeWidth={2} dot={{ r: 4 }} />
              </LineChart>
            </ResponsiveContainer>
          </div>
        </div>

        <div className="bg-white dark:bg-dark-card rounded-xl shadow-sm p-5">
          <h3 className="text-lg font-semibold text-gray-700 dark:text-white mb-4">
            📊 Estado de Órdenes
          </h3>
          <div style={{ width: '100%', height: 250 }}>
            <ResponsiveContainer width="100%" height="100%">
              <BarChart data={orderStatusData} margin={{ top: 5, right: 20, left: 0, bottom: 5 }}>
                <CartesianGrid strokeDasharray="3 3" />
                <XAxis dataKey="name" tick={{ fontSize: 12 }} />
                <YAxis tick={{ fontSize: 12 }} />
                <Tooltip />
                <Bar dataKey="value" radius={[4, 4, 0, 0]}>
                  {orderStatusData.map((_, index) => (
                    <Cell key={`cell-${index}`} fill={colors[index % colors.length]} />
                  ))}
                </Bar>
              </BarChart>
            </ResponsiveContainer>
          </div>
        </div>
      </div>

      {/* Lista de conductores */}
      <div className="bg-white dark:bg-dark-card rounded-xl shadow-sm p-5">
        <DriversList />
      </div>

    </div>
  );
};

export default DashboardPage;
