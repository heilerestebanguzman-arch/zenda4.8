package main

import (
    "database/sql"
    "encoding/json"
    "log"
    "net/http"
    _ "github.com/lib/pq"
)

func main() {
    // Conectar a PostgreSQL
    connStr := "host=localhost port=5432 user=zenda_admin password=zenda_secure_pass_2026 dbname=zenda sslmode=disable"
    db, err := sql.Open("postgres", connStr)
    if err != nil {
        log.Fatal("❌ Error conectando a PostgreSQL:", err)
    }
    defer db.Close()

    if err := db.Ping(); err != nil {
        log.Fatal("❌ Error haciendo ping a PostgreSQL:", err)
    }
    log.Println("✅ Conectado a PostgreSQL exitosamente")

    // Health Check
    http.HandleFunc("/health", func(w http.ResponseWriter, r *http.Request) {
        w.Header().Set("Content-Type", "application/json")
        json.NewEncoder(w).Encode(map[string]string{
            "status":  "OK",
            "service": "modulo_6_cmms",
        })
    })

    // ============================================
    // ENDPOINTS DE RUTAS (con PostgreSQL)
    // ============================================

    // GET /api/v1/routes
    http.HandleFunc("/api/v1/routes", func(w http.ResponseWriter, r *http.Request) {
        if r.Method == "GET" {
            rows, err := db.Query("SELECT id, name, description, color, status, is_active_trip FROM tenant_default.routes")
            if err != nil {
                http.Error(w, err.Error(), http.StatusInternalServerError)
                return
            }
            defer rows.Close()

            var routes []map[string]interface{}
            for rows.Next() {
                var id, name, description, color, status string
                var isActiveTrip bool

                err := rows.Scan(&id, &name, &description, &color, &status, &isActiveTrip)
                if err != nil {
                    http.Error(w, err.Error(), http.StatusInternalServerError)
                    return
                }

                routes = append(routes, map[string]interface{}{
                    "id":             id,
                    "name":           name,
                    "description":    description,
                    "color":          color,
                    "status":         status,
                    "is_active_trip": isActiveTrip,
                })
            }

            w.Header().Set("Content-Type", "application/json")
            json.NewEncoder(w).Encode(map[string]interface{}{
                "success": true,
                "data":    routes,
            })
            return
        }

        if r.Method == "POST" {
            var body struct {
                Name        string `json:"name"`
                Description string `json:"description"`
                Color       string `json:"color"`
                Status      string `json:"status"`
            }

            if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
                http.Error(w, "Datos inválidos", http.StatusBadRequest)
                return
            }

            query := `INSERT INTO tenant_default.routes (name, description, color, status) 
                      VALUES ($1, $2, $3, $4) RETURNING id`

            var id string
            err := db.QueryRow(query, body.Name, body.Description, body.Color, body.Status).Scan(&id)
            if err != nil {
                http.Error(w, err.Error(), http.StatusInternalServerError)
                return
            }

            w.Header().Set("Content-Type", "application/json")
            w.WriteHeader(http.StatusCreated)
            json.NewEncoder(w).Encode(map[string]interface{}{
                "success": true,
                "data": map[string]interface{}{
                    "id":          id,
                    "name":        body.Name,
                    "description": body.Description,
                    "color":       body.Color,
                    "status":      body.Status,
                },
            })
            return
        }

        http.Error(w, "Método no permitido", http.StatusMethodNotAllowed)
    })

    // ============================================
    // ENDPOINTS DE ÓRDENES (con PostgreSQL)
    // ============================================

    // GET /api/v1/orders
    http.HandleFunc("/api/v1/orders", func(w http.ResponseWriter, r *http.Request) {
        if r.Method == "GET" {
            rows, err := db.Query("SELECT id, driver_id, route_id, status, priority, description, scheduled_date, completed_date, estimated_cost, actual_cost FROM tenant_default.orders")
            if err != nil {
                http.Error(w, err.Error(), http.StatusInternalServerError)
                return
            }
            defer rows.Close()

            var orders []map[string]interface{}
            for rows.Next() {
                var id, driverId, routeId, status, priority, description string
                var scheduledDate, completedDate sql.NullTime
                var estimatedCost, actualCost sql.NullFloat64

                err := rows.Scan(&id, &driverId, &routeId, &status, &priority, &description, &scheduledDate, &completedDate, &estimatedCost, &actualCost)
                if err != nil {
                    http.Error(w, err.Error(), http.StatusInternalServerError)
                    return
                }

                order := map[string]interface{}{
                    "id":          id,
                    "driver_id":   driverId,
                    "route_id":    routeId,
                    "status":      status,
                    "priority":    priority,
                    "description": description,
                }

                if scheduledDate.Valid {
                    order["scheduled_date"] = scheduledDate.Time
                }
                if completedDate.Valid {
                    order["completed_date"] = completedDate.Time
                }
                if estimatedCost.Valid {
                    order["estimated_cost"] = estimatedCost.Float64
                }
                if actualCost.Valid {
                    order["actual_cost"] = actualCost.Float64
                }

                orders = append(orders, order)
            }

            w.Header().Set("Content-Type", "application/json")
            json.NewEncoder(w).Encode(map[string]interface{}{
                "success": true,
                "data":    orders,
            })
            return
        }

        if r.Method == "POST" {
            var body struct {
                DriverId      string  `json:"driver_id"`
                RouteId       string  `json:"route_id"`
                Description   string  `json:"description"`
                Priority      string  `json:"priority"`
                ScheduledDate string  `json:"scheduled_date"`
                EstimatedCost float64 `json:"estimated_cost"`
            }

            if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
                http.Error(w, "Datos inválidos", http.StatusBadRequest)
                return
            }

            query := `INSERT INTO tenant_default.orders (driver_id, route_id, description, priority, scheduled_date, estimated_cost, status) 
                      VALUES ($1, $2, $3, $4, $5, $6, 'pending') RETURNING id`

            var id string
            err := db.QueryRow(query, body.DriverId, body.RouteId, body.Description, body.Priority, body.ScheduledDate, body.EstimatedCost).Scan(&id)
            if err != nil {
                http.Error(w, err.Error(), http.StatusInternalServerError)
                return
            }

            w.Header().Set("Content-Type", "application/json")
            w.WriteHeader(http.StatusCreated)
            json.NewEncoder(w).Encode(map[string]interface{}{
                "success": true,
                "data": map[string]interface{}{
                    "id":          id,
                    "driver_id":   body.DriverId,
                    "route_id":    body.RouteId,
                    "description": body.Description,
                    "priority":    body.Priority,
                    "status":      "pending",
                },
            })
            return
        }

        http.Error(w, "Método no permitido", http.StatusMethodNotAllowed)
    })

    port := "8087"
    log.Printf("🚀 M6 - CMMS corriendo en puerto %s", port)
    log.Printf("📝 Health: http://localhost:%s/health", port)
    log.Printf("📝 Routes: http://localhost:%s/api/v1/routes", port)
    log.Printf("📝 Orders: http://localhost:%s/api/v1/orders", port)
    log.Fatal(http.ListenAndServe(":"+port, nil))
}