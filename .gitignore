docker-data/
volumes/
*.vhdx

# === Logs ===
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# === Binarios y compilación ===
bin/
dist/
build/
*.exe
*.dll
*.so
*.dylib
*.out
