# === IDEs ===
.vscode/
.idea/
*.swp
*.swo
*~

# === Sistema Operativo ===
Thumbs.db
.DS_Store
desktop.ini

# === Archivos temporales ===
tmp/
temp/
*.tmp
*.temp

# === Cobertura de pruebas ===
coverage/
*.cover
*.cov
*.lcov

# === Terraform ===
*.tfstate
*.tfstate.*
.terraform/

# === K8s secrets ===
*.secret.yaml
secrets/
