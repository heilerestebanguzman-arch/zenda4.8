{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IncidentCreatedEvent",
  "type": "object",
  "required": ["event_type", "payload"],
  "properties": {
    "event_type": {
      "type": "string",
      "const": "INCIDENT_CREATED"
    },
    "version": {
      "type": "string",
      "default": "1.0.0"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "required": ["incident_id", "severity", "type", "timestamp"],
      "properties": {
        "incident_id": {
          "type": "string",
          "format": "uuid"
        },
        "bus_id": {
          "type": "string"
        },
        "driver_id": {
          "type": "string",
          "format": "uuid"
        },
        "severity": {
          "type": "string",
          "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
        },
        "type": {
          "type": "string",
          "enum": ["PANIC_BUTTON", "COLLISION", "MECHANICAL", "ACCELERATION", "FATIGUE"]
        },
        "location": {
          "type": "object",
          "properties": {
            "latitude": { "type": "number" },
            "longitude": { "type": "number" }
          }
        },
        "description": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
